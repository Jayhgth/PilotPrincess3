---
import "@fontsource-variable/manrope";
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/roboto";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/outfit";
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/syne";
import "@mantine/core/styles.css";
import "@radix-ui/themes/styles.css";
import "@/styles/global.css";
import "@/styles/ui-lab.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pilot Princess",
  description = "Source-backed course planning for Design Tech High School."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f2f3" />
    <link rel="icon" type="image/png" href="/brand/pilot-princess-mark.png" />
    <link rel="icon" type="image/svg+xml" href="/brand/pilot-princess-mark.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("pilot-princess-theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
