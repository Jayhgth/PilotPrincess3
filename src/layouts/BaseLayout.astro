---
import "@fontsource-variable/dm-sans";
import "@/styles/global.css";
import "@/styles/t3code.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pilot Princess",
  description = "Source-backed course and graduation planning for California high school students."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7eef3" />
    <link rel="icon" type="image/svg+xml" href="/brand/pilot-princess-mark.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("pilot-princess-theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class:list={{ "desktop-macos": process.env.PILOT_DESKTOP === "true" && process.platform === "darwin" }}>
    <slot />
  </body>
</html>
