{
  "name": "pilot-princess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:fast": "pnpm typecheck && pnpm test:changed",
    "verify:milestone": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:release": "pnpm verify:milestone && pnpm test:e2e && pnpm colors:validate && pnpm smccd:validate",
    "colors:validate": "node scripts/validate-color-palettes.mjs",
    "smccd:scrape": "node scripts/scrape-smccd-catalog.mjs",
    "smccd:migration": "node scripts/generate-smccd-migration.mjs",
    "equivalencies:generate": "node scripts/generate-equivalency-migration.mjs",
    "smccd:validate": "node scripts/validate-smccd-catalog.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/manrope": "5.2.8",
    "@openai/codex-sdk": "0.144.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "astro": "7.0.7",
    "mammoth": "1.12.0",
    "motion": "^12.42.2",
    "pdf-parse": "2.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.180.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "cheerio": "1.1.2",
    "eslint": "10.6.0",
    "eslint-plugin-astro": "2.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
