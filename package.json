{
  "name": "pilot-princess",
  "version": "0.1.2",
  "description": "Open-source desktop academic planning with a local Codex-powered assistant.",
  "author": "Pilot Princess contributors",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.mjs",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:desktop": "node apps/desktop/dev.mjs",
    "dev:marketing": "pnpm --dir apps/marketing dev",
    "build": "astro build",
    "build:desktop": "pnpm desktop:icons && pnpm build && electron-builder --config apps/desktop/electron-builder.yml",
    "build:desktop:mac": "pnpm desktop:icons && pnpm build && electron-builder --config apps/desktop/electron-builder.yml --mac dmg zip --arm64",
    "build:desktop:win": "pnpm desktop:icons && pnpm build && electron-builder --config apps/desktop/electron-builder.yml --win nsis --x64 --arm64",
    "build:marketing": "pnpm --dir apps/marketing build",
    "desktop:icons": "node apps/desktop/scripts/build-icons.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "deployment:check": "node scripts/check-deployment-readiness.mjs",
    "check": "pnpm typecheck && pnpm test",
    "check:release": "pnpm lint && pnpm check && pnpm deployment:check && pnpm build && pnpm performance:budget && pnpm test:e2e && pnpm smccd:validate",
    "smccd:scrape": "node scripts/scrape-smccd-catalog.mjs",
    "smccd:ge-scrape": "node scripts/scrape-smccd-local-ge.mjs",
    "smccd:migration": "node scripts/generate-smccd-migration.mjs",
    "smccd:requirements-migration": "node scripts/generate-smccd-requirement-migration.mjs",
    "equivalencies:generate": "node scripts/generate-equivalency-migration.mjs",
    "schools:sync": "node scripts/sync-california-schools.mjs",
    "schools:academics": "node --env-file-if-exists=.env scripts/sync-school-academics.mjs",
    "schools:audit": "node --env-file-if-exists=.env scripts/audit-statewide-school-parity.mjs",
    "providers:sync": "node scripts/sync-california-community-colleges.mjs",
    "uc-ag:sync-schools": "node scripts/sync-uc-ag-schools.mjs",
    "uc-ag:sync-courses": "node scripts/sync-uc-ag-courses.mjs",
    "smccd:validate": "node scripts/validate-smccd-catalog.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/dm-sans": "5.2.8",
    "@openai/codex": "0.144.1",
    "@openai/codex-sdk": "0.144.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.110.2",
    "astro": "7.0.7",
    "mammoth": "1.12.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "pdf-parse": "2.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "electron-updater": "^6.7.2",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.144.1-darwin-arm64",
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.144.1-win32-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.144.1-win32-x64"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "10.6.0",
    "eslint-plugin-astro": "2.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
