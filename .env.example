# Browser-safe Supabase configuration. RLS remains the authorization boundary.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional local Pilot tuning. Authentication comes from the Codex account
# connected on this computer, not an API key in this file.
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_MS=350000
