# Public browser configuration. These values are intentionally publishable;
# Supabase RLS remains the authorization boundary.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Pilot credential. Configure this as a Vercel secret and never
# prefix it with PUBLIC_.
OPENAI_API_KEY=your-server-side-openai-api-key
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_MS=285000

# Build-time Vercel function limit. Hobby supports 300 seconds; use 360 on Pro
# to preserve Pilot's full six-minute quality budget.
VERCEL_FUNCTION_MAX_DURATION=300

# Pilot ships the official native Codex runtime, which makes the generated
# function larger than Vercel's standard 250 MB path. Large Functions requires
# Fluid Compute and supports this bundle without exposing another credential.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Local Supabase CLI only. Configure Google directly in the hosted Supabase
# dashboard for production; these do not belong in the Vercel project.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
